{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ],
    "verbatimModuleSyntax": true
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "tests/*.test.ts"
  ],
  "exclude": [
    "packages/connectors/opencode/plugin/**"
  ]
}
